@startuml 02-domain
!include style.iuml

package "ru.itmo.is.lab1.domain" {

    class Organization <<Entity>> {
        - id : long {id > 0, unique, generated by DB}
        - name : String {not null, not blank}
        - coordinates : Coordinates {not null}
        - creationDate : ZonedDateTime {not null, generated}
        - officialAddress : Address [0..1]
        - annualTurnover : Long [0..1] {> 0}
        - employeesCount : long {> 0}
        - rating : Float [0..1] {> 0}
        - fullName : String {not null}
        - type : OrganizationType {not null}
        - postalAddress : Address [0..1]
        ~ onCreate() : void
    }

    class Coordinates <<Entity>> {
        + {static} MAX_X : double = 549
        - id : Long {generated by DB}
        - x : double {x <= 549}
        - y : double
        # Coordinates()
        + Coordinates(x : double, y : double)
    }

    class Address <<Entity>> {
        - id : Long {generated by DB}
        - zipCode : String {not null}
        # Address()
        + Address(zipCode : String)
    }

    enum OrganizationType <<enumeration>> {
        GOVERNMENT
        TRUST
        PRIVATE_LIMITED_COMPANY
    }
}

Organization "*" --> "1" Coordinates : coordinates
Organization "*" --> "0..1" Address : officialAddress
Organization "*" --> "0..1" Address : postalAddress
Organization ..> OrganizationType
@enduml
